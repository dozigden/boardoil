{
  "name": "boardoil-web",
  "version": "1.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm run sync:third-party-licences && node ./scripts/run-vite-with-version.mjs --port 5173",
    "lint": "eslint --max-warnings=0 --config eslint.config.js \"src/shared/api/**/*Api.ts\"",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit --project tsconfig.e2e.json",
    "test": "vitest run",
    "verify-release": "npm run check && npm test",
    "sync:third-party-licences": "node ./scripts/sync-third-party-licences.mjs --publish-public",
    "check": "npm run lint && npm run typecheck && npm run build",
    "build": "npm run sync:third-party-licences && node ./scripts/run-vite-with-version.mjs build",
    "build:demo": "npm run sync:third-party-licences && vite build --config vite.demo.config.ts",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "preview:demo": "vite preview --config vite.demo.config.ts --host 0.0.0.0 --port 4174",
    "test:demo:smoke": "npm run build:demo && playwright test --config playwright.demo.config.ts",
    "test:e2e:smoke": "node ./scripts/run-playwright-smoke.mjs \"\\.smoke\\.spec\\.ts$\"",
    "test:e2e:smoke:external": "node ./scripts/run-playwright-smoke.mjs --external-runtime \"\\.smoke\\.spec\\.ts$\"",
    "test:e2e:regression": "node ./scripts/run-playwright-smoke.mjs",
    "test:e2e:regression:external": "node ./scripts/run-playwright-smoke.mjs --external-runtime"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "@tiptap/extension-link": "^3.22.3",
    "@tiptap/markdown": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "@tiptap/vue-3": "^3.22.3",
    "emoji-picker-element": "^1.29.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "eslint": "^10.2.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.6"
  }
}
